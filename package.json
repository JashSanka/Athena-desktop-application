{
  "name": "athena-proctoring-application",
  "version": "0.1.0",
  "private": true,
  "description": "Athena - Browser-based and desktop proctoring application",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/**/*.test.js",
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development vite & sleep 2 && NODE_ENV=development electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:dmg": "vite build && electron-builder --mac dmg",
    "dist:dmg:arm64": "vite build && electron-builder --mac dmg --arm64",
    "dist:dmg:universal": "vite build && electron-builder --mac dmg --universal"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JashSanka/Athena-desktop-application.git"
  },
  "keywords": [
    "proctoring",
    "assessment",
    "electron",
    "vite",
    "examination"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0"
  }
}
